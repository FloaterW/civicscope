APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Set to true only for initial demo deployment; false once real data is loaded
SEED_ON_STARTUP=false
CORS_ORIGINS=https://YOUR-VERCEL-APP.vercel.app
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com
NEXT_PUBLIC_API_TIMEOUT_MS=60000
FORWARDED_ALLOW_IPS=*
RATE_LIMIT=60/minute
# Optional legacy database API only; the bundled Vercel archive does not use it.
TRREB_PUBLIC_ENABLED=0
# Build-time mode: archive (default), 0 (disabled), or 1 (legacy database API).
# Redeploy the frontend after changing it. No database import is needed for archive.
NEXT_PUBLIC_TRREB_ENABLED=archive
