{
  "name": "civicscope-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "prebuild:analyze": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "build:analyze": "cross-env ANALYZE=true next build",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "demo:video": "node scripts/capture-demo-video.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "start": "node .next/standalone/server.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:trreb": "playwright test --config playwright.trreb.config.ts",
    "test:e2e:trreb-public": "playwright test --config playwright.trreb-public.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.10.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "16.3.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
