{
  "name": "civicscope-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "prebuild:analyze": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "build:analyze": "cross-env ANALYZE=true next build",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "demo:video": "node scripts/capture-demo-video.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "start": "node .next/standalone/server.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.5.5",
    "cross-env": "^10.1.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
