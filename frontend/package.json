{
  "name": "civicscope-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "build:analyze": "cross-env ANALYZE=true next build",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "demo:video": "node scripts/capture-demo-video.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "start": "node .next/standalone/server.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
